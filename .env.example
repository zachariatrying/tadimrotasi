# Supabase Bağlantısı (Opsiyonel — boş bırakıldığında uygulama %100 yerel çevrimdışı modda çalışır)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Google Places API (New) (Opsiyonel — eklendiğinde canlı Google Fotoğrafları ve Google Puanları çekilir)
VITE_GOOGLE_PLACES_API_KEY=YOUR-GOOGLE-API-KEY
